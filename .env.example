# The GoControl cluster this storefront reads. Publishable values: every
# shopper's browser receives them. Fill a local untracked .env.local.
PUBLIC_SUPABASE_URL=https://REF.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The tenant (Airfryer Collective in GoControl).
PUBLIC_FAYZ_STORE_ID=dae85322-34b7-4682-911a-e339a7b5185c
# The integration service (checkout, shipping quote, CEP). Unset means
# https://api.borgesoft.com; set it empty to use the cluster's edge functions.
# PUBLIC_CONTROL_API_URL=https://api.borgesoft.com

# Canonical/OG origin. Unset, it is derived from the incoming request. Set it
# once a custom domain fronts the Worker.
# PUBLIC_SITE_ORIGIN=https://airfryercollective.com

# Only to `npm run deploy` from this machine; CI reads the same two from
# GitHub secrets/vars.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
